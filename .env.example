# Floo injects DATABASE_URL in production. Locally, `npm run dev:local` runs an
# embedded Postgres (PGlite) and sets it for you.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres

# Signs login codes. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Email delivery for login codes, over SMTP from any provider. Gmail: create an
# app password (Google Account > Security > App passwords), host smtp.gmail.com,
# port 465, user = your Gmail address. Without SMTP, codes are printed to the
# server log (always in dev; in prod only if LOG_LOGIN_CODES=1).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Cursus <you@gmail.com>
LOG_LOGIN_CODES=

# Duke OIT Curriculum API, for scripts/import-duke-courses.mjs
DUKE_API_TOKEN=
