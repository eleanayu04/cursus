# Floo injects DATABASE_URL in production. Locally, `npm run dev:local` runs an
# embedded Postgres (PGlite) and sets it for you.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres

# Sign-in is Floo User accounts. Locally there's no sign-in service, so every
# request acts as this user. Leave FLOO_AUTH_URL unset for that to apply.
DEV_USER_EMAIL=dev@duke.edu

# Set on Floo, not locally. Floo publishes FLOO_AUTH_URL itself; the cookie secret
# is yours to generate (at least 32 characters): floo env set --secret
# FLOO_AUTH_URL=
# NEON_AUTH_COOKIE_SECRET=

# Non-Duke emails allowed to use the app, comma-separated, for testing.
# ADMIN_EMAILS=

# Duke OIT Curriculum API, for scripts/import-duke-courses.mjs
DUKE_API_TOKEN=
